{
  "layer": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 2,
  "margin-right": 2,
  "margin-bottom": 2,
  "margin-left": 2,
  "modules-left": ["clock", "battery", "cpu", "memory"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "mpris",
    "pulseaudio",
    "custom/hyprwhspr",
    "custom/bluetooth",
    "tray",
    "backlight",
  ],
  "custom/launcher": {
    "format": "\uf303 ",
    "on-click": "rofi -show drun",
    "on-click-right": "killall rofi",
    "tooltip": false,
  },
  "custom/bluetooth": {
    "format": "\udb80\udcaf",
    "on-click": "blueman-manager",
    "on-click-right": "killall blueman-manager",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "music": "\udb81\udf5a ",
      "1": "\uea85 ",
      "2": "\uf121 ",
      "3": "\uf0ac ",
    },
    "persistent-workspaces": {
      "*": ["music", 1, 2, 3, 4, 5],
    },
  },
  "mpris": {
    "format": "\uf04c  {title} - {artist}",
    "format-paused": "\uf04b  {title} - {artist}",
    "format-stopped": "\uf04d",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span font='12'>{icon}</span>",
    "format-icons": [
      "\ue3d5",
      "\ue3d6",
      "\ue3d7",
      "\ue3d8",
      "\ue3da",
      "\ue3db",
      "\ue3dc",
      "\ue3dd",
      "\ue3de",
      "\ue3df",
    ],
    "on-scroll-down": "brightnessctl s +5%",
    "on-scroll-up": "brightnessctl s 5%-",
    "smooth-scrolling-threshold": 1,
    "tooltip": false,
  },
  "clock": {
    "format": "{:%H:%M - %d.%m.%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "cpu": {
    "format": "{usage}% \uee9c ",
    "interval": 2,
    "states": {
      "critical": 90,
    },
  },
  "memory": {
    "format": "{percentage}% \ue266 ",
    "interval": 2,
    "states": {
      "critical": 80,
    },
  },
  "battery": {
    "format": "{capacity}%  {icon}",
    "format-charging": "{capacity}% \udb80\udc84 ",
    "format-plugged": "{capacity}% \udb80\udc84 \ueb2d",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7e",
      "\udb80\udc80",
      "\udb80\udc82",
      "\udb80\udc79",
    ],
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "tooltip": false,
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "\udb80\udcb0",
    "format-muted": "\uf466",
    "tooltip-format": "{volume}% {icon}",
    "format-icons": {
      "headphones": "\uf025",
      "bluetooth": "\udb82\udd70",
      "handsfree": "\uf025",
      "headset": "\udb86\udc6c",
      "phone": "\uf095",
      "portable": "\uf095",
      "car": "\uf1b9",
      "default": ["\uf026", "\uf027", "\uf028"],
    },
    "scroll-step": 5,
    "justify": "center",
    "on-click": "amixer sset Master toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10,
  },
  "custom/control": {
    "format": "\uf013 ",
    "on-click": "control",
    "on-click-right": "killall control",
    "tooltip": false,
  },
  "include": ["/home/pipo/.config/waybar/hyprwhspr-module.jsonc"],
}
