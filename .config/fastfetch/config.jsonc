{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4,
      "bottom": 2,
    },
    "height": 19,
  },
  "display": {
    "separator": " -> ",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    },
    {
      "type": "custom",
      "format": "Hardware Information",
    },
    {
      "type": "host",
      "key": "󰌢",
    },
    {
      "type": "cpu",
      "key": "",
    },
    {
      "type": "gpu",
      "key": "󰢮",
    },
    {
      "type": "memory",
      "key": "󰘚",
    },
    {
      "type": "display",
      "key": "󰍹",
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    },
    {
      "type": "custom",
      "format": "Software Information",
    },
    {
      "type": "os",
      "key": "",
    },
    {
      "type": "kernel",
      "key": "",
    },
    {
      "type": "terminal",
      "key": "",
    },
    {
      "type": "custom",
      "format": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;253m󰮯  \u001b[38;5;167m󰊠  \u001b[38;5;143m󰊠  \u001b[38;5;216m󰊠  \u001b[38;5;110m󰊠  \u001b[38;5;139m󰊠  \u001b[38;5;109m󰊠  \u001b[38;5;248m󰊠",
    },
  ],
}
