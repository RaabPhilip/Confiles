windowrule = border_size 0, rounding 0, match:float 0, match:workspace w[tv1]
windowrule = border_size 0, rounding 0, match:float 0, match:workspace f[1]

# Example windowrule
# windowrule = float,class:^(kitty)$,title:^(kitty)$

# Ignore maximize requests from apps. You'll probably like this.
windowrule = suppress_event maximize, match:class .*

# Fix some dragging issues with XWayland
windowrule = no_focus on, match:class ^$, match:title ^$, match:xwayland 1, match:float 1, match:fullscreen 0, match:pin 0

# for clipse
windowrule = float on, size 622 652, stay_focused on, match:class (clipse)

# daily update
windowrule = float on, size 622 652, stay_focused off, match:class (daily)

# ScreenShot Tool
windowrule = float on, size 622 652, stay_focused on, match:title (Hyprshot)

# Bitwarden11
# windowrule = float on, size 622 652, stay_focused on, match:title (Extension:.*)

# Librepods
windowrule = float on, size 622 652, stay_focused on, match:title (LibrePods)

# Bluetooth Tool
windowrule = float on, size 622 652, stay_focused on, match:class (blueman-manager)

# Video Player
windowrule = float on, fullscreen off, stay_focused off, match:class (mpv)

# layerrule = blur, waybar
#windowrule = opacity 0.9, match:class (Alacritty)

# windowrule = workspace 1, match:class (Alacritty)
32windowrule = workspace 3, match:class (zen)
windowrule = workspace 2, match:class (code-oss)
windowrule = workspace 2, match:class (dev.zed.Zed)
# windowrule = workspace 2, class:^(jetbrains-pycharm)$
# windowrule = workspace 2, class:^(jetbrains-idea)$
# windowrule = workspace 2, class:^(jetbrains-webstrom)$
# windowrule = workspace 2, class:^(jetbrains-rider)$
# windowrule = workspace 2, class:^(jetbrains-datagrip)$
windowrule = workspace name:music, match:class (spotify)
windowrule = workspace name:notes, match:class (obsidian)
